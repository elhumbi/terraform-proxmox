certs/

# ---------------------------------------------------------------
# Dateien mit echten Secrets – nur die *.example.* Varianten werden
# versioniert. Neue Secret-Dateien hier explizit eintragen.
# ---------------------------------------------------------------
kubernetes/auth/authentik/values.yaml
kubernetes/auth/headlamp/values-oidc.yaml
kubernetes/auth/oauth2-proxy/values.yaml
kubernetes/infra/newt/newt-with-secret.yaml
kubernetes/infra/newt/credentials.md
*.pem
*.key
*.crt
*.p12
*.pfx
*secret*
*password*
*token*
!*.example.*
# Sealed Secrets (kubeseal, nur mit Cluster-Private-Key entschlüsselbar) sind
# bewusst versioniert – ebenso das öffentliche Zertifikat des Controllers.
!*.sealed.yaml
!kubernetes/infra/sealed-secrets/
!kubernetes/infra/sealed-secrets/pub-cert.pem

